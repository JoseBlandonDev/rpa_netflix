# Configuración del servidor IMAP
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_TIMEOUT=30

# Credenciales del correo electrónico
EMAIL_ADDRESS=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion

# Filtros de correo
SENDER_FILTER=netflix.com
LINK_PATTERN=https://www.netflix.com/account/update-primary-location

# Configuración del navegador web
BUTTON_SELECTOR=button[type="submit"]
TIMEOUT_SECONDS=10

# Configuración de la base de datos
DB_PATH=rpa_database.db

# Configuración de eliminación automática de correos
AUTO_DELETE_EMAILS=true

# Configuración SMTP para el envío de reportes (correos con "REPORTE" en asunto/cuerpo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion 