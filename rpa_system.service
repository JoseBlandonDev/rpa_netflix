[Unit]
Description=Sistema RPA - Automatización de correos electrónicos
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/automatizacion
ExecStart=/usr/bin/python3 /root/automatizacion/rpa/main.py
StandardOutput=journal
StandardError=journal
EnvironmentFile=/root/automatizacion/.env
TimeoutSec=300

# Configuración de seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/automatizacion

[Install]
WantedBy=multi-user.target
