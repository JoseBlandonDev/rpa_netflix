[Unit]
Description=Sistema RPA - Automatización de correos electrónicos
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/repo_rpa
ExecStart=/usr/bin/python3 /root/repo_rpa/rpa/main.py
StandardOutput=journal
StandardError=journal
EnvironmentFile=/root/repo_rpa/.env

# Configuración de seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/repo_rpa

[Install]
WantedBy=multi-user.target 